{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "chmod +x pb/pocketbase && cp pb/pocketbase pocketbase-binary && cp pb/start.sh start.sh",
    "installCommand": "cp -r pb/pb_migrations ./migrations && cp pb/pb_hooks ./pb_hooks"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "./start.sh"
  }
}